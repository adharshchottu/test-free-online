---
import { tools } from "@/data/tools";
---

<!-- Sits right under the hero, whose bottom margin already provides the top spacing -->
<section class="w-full bg-bgDark2 pb-24 scroll-mt-24" id="tools">
  <div class="2xl:w-[1280px] xl:w-10/12 w-11/12 mx-auto">
    <div class="max-w-2xl mb-12 text-center lg:text-left mx-auto lg:mx-0">
      <span class="block-subtitle">All tools</span>
      <h2 class="mt-6 mb-4 block-big-title">Everything in one place</h2>
      <p class="text-secondaryText leading-loose">
        Free, no signup, right in your browser.
      </p>
    </div>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="block h-full p-6 bg-bgDark3 hover:bg-bgDark3Hover main-border-gray-darker rounded-2xl transition"
            >
              <span class="block-subtitle">{tool.category}</span>
              <h3 class="mt-3 mb-2 content-title">{tool.name}</h3>
              <p class="text-secondaryText text-sm leading-relaxed">
                {tool.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
