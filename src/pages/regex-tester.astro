---
import { Navbar } from "@/components/Navbar";
import Layout from "../layouts/Layout.astro";
import Footer from "@/components/Footer.vue";
import { ScrollUpButton } from "@/components/ScrollUpButton";
import "../styles/Theme.css";

const inputClass =
    "w-full p-3 font-mono text-sm main-border-gray rounded-xl bg-bgDark2 text-primaryText placeholder-gray-500 focus:outline-none focus:border-primaryColor";
const buttonClass =
    "px-3 py-2 bg-bgDark2 hover:bg-bgDark1 text-primaryText text-sm rounded-lg transition-colors border border-gray-700 hover:border-primaryColor";
const flags = [
    { flag: "g", title: "global: find all matches" },
    { flag: "i", title: "ignore case" },
    { flag: "m", title: "multiline: ^ and $ match at line breaks" },
    { flag: "s", title: "dotAll: . also matches line breaks" },
    { flag: "u", title: "unicode" },
    { flag: "y", title: "sticky: match only at lastIndex" },
];
const cheatSheet = [
    [".", "any character except a line break"],
    ["\\d \\w \\s", "digit, word character, whitespace"],
    ["\\D \\W \\S", "not a digit, word character, whitespace"],
    ["[abc] [^abc]", "any of / none of a, b, c"],
    ["a* a+ a?", "0 or more, 1 or more, 0 or 1"],
    ["a{2,5}", "between 2 and 5 times"],
    ["a+?", "lazy: as few as possible"],
    ["^ $", "start / end of string (or line with m)"],
    ["\\b", "word boundary"],
    ["(abc)", "capture group, used as $1"],
    ["(?<name>abc)", "named group, used as $<name>"],
    ["(?:abc)", "group without capturing"],
    ["a|b", "a or b"],
    ["(?=a) (?!a)", "followed by / not followed by a"],
    ["(?<=a) (?<!a)", "preceded by / not preceded by a"],
];
---

<Layout
    title="Regex Tester Online - Test JavaScript Regular Expressions"
    description="Test regular expressions online with live match highlighting, capture and named groups, replace preview and a quick reference. Protected against runaway patterns."
    ogImage="blog/regex-tester.png"
    keywords="regex tester, regular expression tester, test regex online, javascript regex, regex match, regex replace, named groups, regex cheat sheet"
>
    <Navbar client:load />
    <section class="pt-16 md:pt-16 lg:pt-24">
        <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="mb-6">
                <h1 class="block-big-title">Regex Tester</h1>
                <p class="mt-3 text-secondaryText">
                    Write a JavaScript regular expression and see what it matches as you type.
                </p>
            </div>

            <div class="p-4 bg-bgDark3 main-border-gray rounded-xl mb-4">
                <label for="pattern" class="block text-sm text-secondaryText mb-2">Regular expression</label>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-secondaryText text-lg">/</span>
                    <input id="pattern" type="text" spellcheck="false" autocomplete="off" placeholder="[a-z]+" class={inputClass} />
                    <span class="font-mono text-secondaryText text-lg">/</span>
                    <span id="flagText" class="font-mono text-primaryColor text-lg min-w-[3ch]">g</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-3">
                    {
                        flags.map(({ flag, title }) => (
                            <label class="text-sm text-secondaryText flex items-center gap-1 font-mono" title={title}>
                                <input type="checkbox" class="flag accent-primaryColor" value={flag} checked={flag === "g"} />
                                {flag}
                            </label>
                        ))
                    }
                    <span class="grow"></span>
                    <button id="sampleBtn" class={buttonClass}>Sample</button>
                    <button id="clearBtn" class={buttonClass}>Clear</button>
                </div>
                <p id="status" class="mt-3 text-sm text-secondaryText" aria-live="polite">Enter a pattern to start.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div>
                    <label for="text" class="block mb-2 text-sm text-secondaryText">Test string</label>
                    <textarea id="text" spellcheck="false" placeholder="Paste the text to test against" class={`${inputClass} min-h-[220px] resize-y`}></textarea>
                    <span class="block mt-4 mb-2 text-sm text-secondaryText">Highlighted matches</span>
                    <div id="highlight" class="min-h-[120px] p-3 font-mono text-sm leading-relaxed whitespace-pre-wrap break-all main-border-gray rounded-xl bg-bgDark2 text-secondaryText"></div>
                </div>
                <div>
                    <span class="block mb-2 text-sm text-secondaryText">Matches</span>
                    <ol id="matches" class="max-h-[360px] overflow-y-auto space-y-2 p-3 main-border-gray rounded-xl bg-bgDark2 text-sm"></ol>
                    <label for="replacement" class="block mt-4 mb-2 text-sm text-secondaryText">Replace with ($1, $&lt;name&gt;, $&amp;)</label>
                    <input id="replacement" type="text" spellcheck="false" placeholder="Leave empty to skip" class={inputClass} />
                    <pre id="replaced" class="mt-2 min-h-[80px] p-3 font-mono text-sm whitespace-pre-wrap break-all main-border-gray rounded-xl bg-bgDark2 text-primaryText"></pre>
                </div>
            </div>
        </div>
    </section>

    <section class="text-secondaryText leading-8 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 mb-16">
        <h2 class="text-white text-2xl mb-4">Quick reference</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-sm mb-6">
            {
                cheatSheet.map(([token, meaning]) => (
                    <div class="flex gap-3">
                        <dt class="font-mono text-primaryText min-w-[9rem]">{token}</dt>
                        <dd>{meaning}</dd>
                    </div>
                ))
            }
        </dl>
        <p>
            This tester uses your browser's JavaScript regex engine, the same one used by Node.js. Read the
            <a href="/blog/how-to-test-regex-online/" class="text-pink-400 font-bold">full guide</a>
            for worked examples.
        </p>
    </section>
    <ScrollUpButton client:load />
    <Footer client:only="vue" />
</Layout>

<script>
    const patternInput = document.getElementById("pattern") as HTMLInputElement;
    const textInput = document.getElementById("text") as HTMLTextAreaElement;
    const replacementInput = document.getElementById("replacement") as HTMLInputElement;
    const flagText = document.getElementById("flagText") as HTMLSpanElement;
    const status = document.getElementById("status") as HTMLParagraphElement;
    const highlight = document.getElementById("highlight") as HTMLDivElement;
    const matchesList = document.getElementById("matches") as HTMLOListElement;
    const replaced = document.getElementById("replaced") as HTMLPreElement;
    const flagBoxes = [...document.querySelectorAll<HTMLInputElement>(".flag")];

    const STORAGE_KEY = "regexTesterState";
    const MAX_MATCHES = 1000;
    const TIMEOUT_MS = 1500;

    interface Match {
        index: number;
        text: string;
        groups: (string | undefined)[];
        named: Record<string, string | undefined> | null;
    }

    // Runs in a worker so a runaway pattern can be stopped instead of freezing the page
    const workerSource = `
        self.onmessage = ({ data: { pattern, flags, text, replacement, max } }) => {
            let re;
            try {
                re = new RegExp(pattern, flags);
            } catch (error) {
                self.postMessage({ error: error.message });
                return;
            }
            const toMatch = (m) => ({ index: m.index, text: m[0], groups: m.slice(1), named: m.groups ?? null });
            const matches = [];
            let truncated = false;
            if (re.global) {
                for (const m of text.matchAll(re)) {
                    if (matches.length === max) { truncated = true; break; }
                    matches.push(toMatch(m));
                }
            } else {
                const m = re.exec(text);
                if (m) matches.push(toMatch(m));
            }
            re.lastIndex = 0;
            const result = replacement === null ? null : text.replace(re, replacement);
            self.postMessage({ matches, truncated, replaced: result });
        };
    `;
    const workerUrl = URL.createObjectURL(new Blob([workerSource], { type: "text/javascript" }));
    let worker: Worker | null = null;
    let timeout: number | undefined;

    const getFlags = () => flagBoxes.filter((box) => box.checked).map((box) => box.value).join("");

    const setStatus = (message: string, tone: "ok" | "error" | "neutral") => {
        status.textContent = message;
        const colors = { ok: "text-green-400", error: "text-red-400", neutral: "text-secondaryText" };
        status.className = `mt-3 text-sm ${colors[tone]}`;
    };

    const renderHighlight = (text: string, matches: Match[]) => {
        const nodes: Node[] = [];
        let last = 0;
        for (const match of matches) {
            if (!match.text) continue;
            if (match.index > last) nodes.push(document.createTextNode(text.slice(last, match.index)));
            const mark = document.createElement("mark");
            mark.className = "bg-primaryColor/40 text-primaryText rounded px-px";
            mark.textContent = match.text;
            nodes.push(mark);
            last = match.index + match.text.length;
        }
        nodes.push(document.createTextNode(text.slice(last)));
        highlight.replaceChildren(...nodes);
    };

    const renderMatches = (matches: Match[]) => {
        matchesList.replaceChildren(
            ...matches.map((match, i) => {
                const item = document.createElement("li");
                item.className = "p-2 rounded-lg bg-bgDark3";
                const head = document.createElement("div");
                head.className = "text-secondaryText text-xs mb-1";
                head.textContent = `Match ${i + 1} at index ${match.index}`;
                const body = document.createElement("div");
                body.className = "font-mono text-primaryText break-all";
                body.textContent = match.text === "" ? "(empty match)" : match.text;
                item.append(head, body);
                const named = Object.entries(match.named ?? {});
                const groupLines = [
                    ...match.groups.map((value, g) => `$${g + 1}: ${value ?? "(no match)"}`),
                    ...named.map(([name, value]) => `$<${name}>: ${value ?? "(no match)"}`),
                ];
                if (groupLines.length) {
                    const groups = document.createElement("div");
                    groups.className = "font-mono text-xs text-secondaryColor mt-1 whitespace-pre-wrap break-all";
                    groups.textContent = groupLines.join("\n");
                    item.append(groups);
                }
                return item;
            }),
        );
    };

    const clearResults = () => {
        highlight.textContent = textInput.value;
        matchesList.replaceChildren();
        replaced.textContent = "";
    };

    const saveState = () => {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                pattern: patternInput.value,
                flags: getFlags(),
                text: textInput.value,
                replacement: replacementInput.value,
            }));
        } catch {}
    };

    const run = () => {
        const flags = getFlags();
        flagText.textContent = flags;
        saveState();
        worker?.terminate();
        window.clearTimeout(timeout);

        if (!patternInput.value) {
            clearResults();
            setStatus("Enter a pattern to start.", "neutral");
            return;
        }

        const text = textInput.value;
        worker = new Worker(workerUrl);
        timeout = window.setTimeout(() => {
            worker?.terminate();
            worker = null;
            clearResults();
            setStatus(`Stopped after ${TIMEOUT_MS / 1000} seconds. This pattern is likely backtracking catastrophically; try making nested quantifiers like (a+)+ more specific.`, "error");
        }, TIMEOUT_MS);

        worker.onmessage = ({ data }) => {
            window.clearTimeout(timeout);
            worker?.terminate();
            worker = null;
            if (data.error) {
                clearResults();
                setStatus(`Invalid pattern: ${data.error}`, "error");
                return;
            }
            const matches: Match[] = data.matches;
            renderHighlight(text, matches);
            renderMatches(matches);
            replaced.textContent = data.replaced ?? "";
            if (!matches.length) {
                setStatus("No matches.", "neutral");
            } else {
                const groupCount = matches[0].groups.length;
                setStatus(
                    `${data.truncated ? `First ${MAX_MATCHES}` : matches.length} match${matches.length === 1 ? "" : "es"}` +
                        (groupCount ? `, ${groupCount} group${groupCount === 1 ? "" : "s"} each` : "") +
                        (flags.includes("g") || matches.length > 1 ? "." : ". Turn on the g flag to find all matches."),
                    "ok",
                );
            }
        };

        worker.postMessage({
            pattern: patternInput.value,
            flags,
            text,
            replacement: replacementInput.value === "" ? null : replacementInput.value,
            max: MAX_MATCHES,
        });
    };

    let debounce: number | undefined;
    const scheduleRun = () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(run, 120);
    };

    [patternInput, textInput, replacementInput].forEach((el) => el.addEventListener("input", scheduleRun));
    flagBoxes.forEach((box) => box.addEventListener("change", run));

    const applyState = (state: { pattern: string; flags: string; text: string; replacement: string }) => {
        patternInput.value = state.pattern;
        textInput.value = state.text;
        replacementInput.value = state.replacement;
        flagBoxes.forEach((box) => (box.checked = state.flags.includes(box.value)));
        run();
    };

    document.getElementById("sampleBtn")!.addEventListener("click", () =>
        applyState({
            pattern: "(?<user>[\\w.+-]+)@(?<domain>[\\w-]+(?:\\.[\\w-]+)+)",
            flags: "gi",
            text: "Contact us at hello@typinks.com or support@tools.typinks.com.\nInvalid: user@localhost, @example.com",
            replacement: "$<user> [at] $<domain>",
        }),
    );
    document.getElementById("clearBtn")!.addEventListener("click", () =>
        applyState({ pattern: "", flags: "g", text: "", replacement: "" }),
    );

    try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
        if (saved) applyState(saved);
    } catch {}
</script>
